# Configuration Telecom02 Backend - FastAPI Application

# MySQL Database Configuration (XAMPP)
# Connection String Format: mysql+pymysql://username:password@host:port/database
DATABASE_URL=mysql+pymysql://root:@localhost:3306/hgw_db
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=hgw_db

# JWT Configuration (Generate with: openssl rand -hex 32)
SECRET_KEY=your_super_secret_key_generated_with_openssl_rand_hex_32_here_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq LLM API (for Chat AI)
GROQ_API_KEY=your_groq_api_key_here

# MCP Server Configuration
MCP_SERVER_PATH=C:\Users\slimm\Desktop\MCP\mcpserver\main.py
MCP_SERVER_PORT=8000

# Telnet Gateway (Default credentials)
TELNET_HOST=192.168.1.1
TELNET_PORT=23
TELNET_USERNAME=admin
TELNET_PASSWORD=password123

# CORS Configuration (Allow Frontend)
CORS_ORIGINS=["http://localhost:4200","http://localhost:3000","http://127.0.0.1:4200"]

# Server Configuration
DEBUG=True
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
WORKERS=4

# API Rate Limiting (Optional)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
